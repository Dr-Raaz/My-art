rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "raazprasai1996@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Categories Collection
    match /categories/{categoryId} {
      // Public visitors can read active categories
      allow get: if resource.data.isActive == true || isAdmin();
      allow list: if resource.data.isActive == true || isAdmin();

      // Only authenticated admins can modify categories
      allow create: if isAdmin() && isValidId(categoryId);
      allow update: if isAdmin() && isValidId(categoryId);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // Artworks Collection
    match /artworks/{artworkId} {
      // Public visitors can read published artwork
      allow get: if resource.data.isPublished == true || isAdmin();
      allow list: if resource.data.isPublished == true || isAdmin();

      // Only authenticated admins can write artwork
      allow create: if isAdmin() && isValidId(artworkId);
      allow update: if isAdmin() && isValidId(artworkId);
      allow delete: if isAdmin() && isValidId(artworkId);
    }
  }
}
